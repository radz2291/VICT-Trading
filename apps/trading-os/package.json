{
	"name": "trading-os-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Trading OS — SvelteKit consumer host and composition root around the public VICT renderer. Scaffolded once with @victframework/scaffolder@0.1.1; every application file is author-owned.",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --project app"
	},
	"dependencies": {
		"@trading-os/trading-capabilities": "0.1.0",
		"@trading-os/trading-data": "0.1.0",
		"@trading-os/trading-domain": "0.1.0",
		"@trading-os/trading-surfaces": "0.1.0",
		"@victframework/appdata-sqlite": "0.1.1",
		"@victframework/application": "0.1.1",
		"@victframework/contracts": "0.1.1",
		"@victframework/renderer-svelte": "0.1.1",
		"@victframework/runtime": "0.1.1",
		"@victframework/sdk": "0.1.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/node": "^22.13.0",
		"happy-dom": "^20.14.3",
		"svelte": "^5.28.0",
		"svelte-check": "^4.2.0",
		"vite": "6.4.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"license": "Apache-2.0"
}
